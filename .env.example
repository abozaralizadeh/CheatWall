# Copy to .env (local) or /etc/cheatwall/cheatwall.env (VM). Never commit real values.

# Server
PORT=3000
HOST=127.0.0.1
# Who may tell us the visitor's address through X-Forwarded-For. Leave false with no proxy.
# Use 127.0.0.1 when nginx or Caddy runs on the same machine (setup_service.sh sets this for you).
TRUST_PROXY=false
# Where the site lives in the browser. "/" normally, or a path like /cheatwall/ behind a shared nginx.
BASE_PATH=/

# Where the database, posters and logs live
DATA_DIR=./data
LOG_DIR=./logs

# Text provider: "fake" (local sample data, no cost), "azure" (Azure OpenAI) or "anthropic"
PROVIDER=fake

# Needed only when PROVIDER=azure. Leave the key empty in this file and fill it in on the server.
# Endpoint is the resource URL, like https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Used when the main deployment is busy or down. Empty endpoint or key means the same as the main one.
FALLBACK_AZURE_OPENAI_ENDPOINT=
FALLBACK_AZURE_OPENAI_API_KEY=
FALLBACK_AZURE_OPENAI_DEPLOYMENT=
# Empty uses the v1 API. Set a version (like 2025-04-01-preview) only for the older deployments API.
AZURE_OPENAI_API_VERSION=

# Needed only when PROVIDER=anthropic. Leave empty in this file.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Prices in cents per million tokens, used for the money cap. Set them to your model's real prices.
PRICE_INPUT_CENTS_PER_MTOK=400
PRICE_OUTPUT_CENTS_PER_MTOK=2000

# Limits (defaults, change freely). All daily limits reset at midnight UTC and are checked before every AI call.
# When one is used up, visitors get a polite "full for today" message.
DAILY_CAP_CENTS=500
# Total AI tokens (in plus out) per day, for everyone together
DAILY_TOKEN_BUDGET=2000000
# Total AI requests per day, for everyone together. One poster takes 3 to 5.
DAILY_REQUEST_CAP=300
# Per visitor (by IP address)
POSTERS_PER_VISITOR_PER_DAY=3
ATTEMPTS_PER_VISITOR_PER_DAY=15
RETENTION_DAYS=30
JOB_CONCURRENCY=2
RENDER_CONCURRENCY=2

# Poster look
DEFAULT_THEME=paper
POSTER_WIDTH_MM=420
POSTER_HEIGHT_MM=594

# Optional: full path to Chrome or Chromium. Found automatically when empty.
CHROME_PATH=

# Log file rotation
LOG_MAX_BYTES=10485760
LOG_KEEP=5
