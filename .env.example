# Copy to .env (local) or /etc/cheatwall/cheatwall.env (VM). Never commit real values.

# Server
PORT=3000
HOST=127.0.0.1
# Set to true only when Caddy (or another proxy you control) is in front
TRUST_PROXY=false

# Where the database, posters and logs live
DATA_DIR=./data
LOG_DIR=./logs

# Text provider: "fake" (local sample data, no cost) or "anthropic"
PROVIDER=fake
# Needed only when PROVIDER=anthropic. Leave empty in this file.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Prices in cents per million tokens, used for the spend cap
PRICE_INPUT_CENTS_PER_MTOK=400
PRICE_OUTPUT_CENTS_PER_MTOK=2000

# Limits (defaults, change freely)
DAILY_CAP_CENTS=500
POSTERS_PER_VISITOR_PER_DAY=3
ATTEMPTS_PER_VISITOR_PER_DAY=15
RETENTION_DAYS=30
JOB_CONCURRENCY=2
RENDER_CONCURRENCY=2

# Poster look
DEFAULT_THEME=paper
POSTER_WIDTH_MM=420
POSTER_HEIGHT_MM=594

# Optional: full path to Chrome or Chromium. Found automatically when empty.
CHROME_PATH=

# Log file rotation
LOG_MAX_BYTES=10485760
LOG_KEEP=5
