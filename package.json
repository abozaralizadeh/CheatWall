{
  "name": "cheatwall",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "CheatWall (working name): AI cheat sheet posters for any topic",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test --test-concurrency=1 \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "poster": "node scripts/make-poster.ts",
    "phase1": "node scripts/phase1-batch.ts",
    "samples": "node scripts/make-samples.ts",
    "backup": "node scripts/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "katex": "0.19.1",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
